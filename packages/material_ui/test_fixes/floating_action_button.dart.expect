import 'package:material_ui/material_ui.dart';

void main() {
  // Changes made in https://github.com/flutter/packages/pull/13771
  Widget fab = FloatingActionButton.mini(onPressed: () {});
  fab = FloatingActionButton.mini(
    onPressed: () {},
    tooltip: 'Add',
    child: const Icon(Icons.add),
  );
  fab = const FloatingActionButton.mini(onPressed: null);

  // Changes made in https://github.com/flutter/packages/pull/13771
  var themeData = FloatingActionButtonThemeData(miniSizeConstraints: BoxConstraints());
  themeData = themeData.copyWith(miniSizeConstraints: BoxConstraints());
  themeData.miniSizeConstraints;
}
