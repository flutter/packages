# Kotlin classes that package:jni and the generated Dart code look up by name
# through JNI. Classes generated by Pigeon are annotated with @Keep, but library
# classes can't be annotated, so they need explicit rules until package:jni
# provides them. See "Android Release Build Configuration (JNI)" in
# native_interop_guide.md.
#
# TODO(tarrinneal): Delete this file and its consumerProguardFiles entry in
# build.gradle.kts once package:jni ships these rules:
# https://github.com/dart-lang/native/issues/3732
-keep class kotlin.Unit { *; }
-keep class kotlin.Result { *; }
-keep class kotlin.Result$Failure { *; }
-keep class kotlin.coroutines.Continuation { *; }
-keep class kotlin.coroutines.intrinsics.CoroutineSingletons { *; }
-keep class kotlin.coroutines.intrinsics.IntrinsicsKt { *; }
