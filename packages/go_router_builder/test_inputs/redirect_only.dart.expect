RouteBase get $redirectRoute => GoRouteData.$route(
  path: '/redirect',
  hasOverriddenOnExit: false,
  redirectOnly: true,
  factory: $RedirectRoute._fromState,
);

mixin $RedirectRoute on GoRouteData {
  static RedirectRoute _fromState(GoRouterState state) => RedirectRoute();

  @override
  String get location => GoRouteData.$location('/redirect');

  @override
  void go(BuildContext context) => context.go(location);

  @override
  Future<T?> push<T>(BuildContext context) => context.push<T>(location);

  @override
  void pushReplacement(BuildContext context) => context.pushReplacement(location);

  @override
  void replace(BuildContext context) => context.replace(location);
}

