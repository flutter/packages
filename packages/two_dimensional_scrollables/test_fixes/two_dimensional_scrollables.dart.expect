import 'package:flutter/rendering.dart' show ViewportOffset;
import 'package:flutter/widgets.dart';
import 'package:two_dimensional_scrollables/two_dimensional_scrollables.dart';

void testFixes(TwoDimensionalChildManager childManager, double extent) {
  final TableCellBuilderDelegate tableDelegate = TableCellBuilderDelegate(
    columnBuilder: (int index) =>
        const TableSpan(extent: FixedTableSpanExtent(100)),
    rowBuilder: (int index) =>
        const TableSpan(extent: FixedTableSpanExtent(100)),
    cellBuilder: (BuildContext context, TableVicinity vicinity) =>
        const TableViewCell(child: SizedBox()),
  );
  final TreeRowBuilderDelegate treeDelegate = TreeRowBuilderDelegate(
    rowCount: 0,
    nodeBuilder: (BuildContext context, ChildVicinity vicinity) =>
        const SizedBox(),
    rowBuilder: (TreeVicinity vicinity) =>
        const TreeRow(extent: FixedTreeRowExtent(40)),
  );
  final ViewportOffset verticalOffset = ViewportOffset.zero();
  final ViewportOffset horizontalOffset = ViewportOffset.zero();

  TableView(scrollCacheExtent: ScrollCacheExtent.pixels(100.0), delegate: tableDelegate);
  TableView(scrollCacheExtent: ScrollCacheExtent.pixels(extent), delegate: tableDelegate);
  TableView(delegate: tableDelegate);
  TableView(
    scrollCacheExtent: const ScrollCacheExtent.viewport(1.0),
    delegate: tableDelegate,
  );
  TableView(
    scrollCacheExtent: ScrollCacheExtent.pixels(100.0), delegate: tableDelegate,
  );
  TableView(
    scrollCacheExtent: const ScrollCacheExtent.viewport(1.0),
    delegate: tableDelegate,
  );
  TableView.builder(
    scrollCacheExtent: ScrollCacheExtent.pixels(100.0), columnBuilder: (int index) =>
        const TableSpan(extent: FixedTableSpanExtent(100)),
    rowBuilder: (int index) =>
        const TableSpan(extent: FixedTableSpanExtent(100)),
    cellBuilder: (BuildContext context, TableVicinity vicinity) =>
        const TableViewCell(child: SizedBox()),
  );
  TableView.list(
    scrollCacheExtent: ScrollCacheExtent.pixels(100.0), columnBuilder: (int index) =>
        const TableSpan(extent: FixedTableSpanExtent(100)),
    rowBuilder: (int index) =>
        const TableSpan(extent: FixedTableSpanExtent(100)),
  );
  TableViewport(
    scrollCacheExtent: ScrollCacheExtent.pixels(100.0), verticalOffset: verticalOffset,
    verticalAxisDirection: AxisDirection.down,
    horizontalOffset: horizontalOffset,
    horizontalAxisDirection: AxisDirection.right,
    delegate: tableDelegate,
    mainAxis: Axis.vertical,
  );
  RenderTableViewport(
    scrollCacheExtent: ScrollCacheExtent.pixels(100.0), horizontalOffset: horizontalOffset,
    horizontalAxisDirection: AxisDirection.right,
    verticalOffset: verticalOffset,
    verticalAxisDirection: AxisDirection.down,
    delegate: tableDelegate,
    mainAxis: Axis.vertical,
    childManager: childManager,
  );
  TreeView<String>(scrollCacheExtent: ScrollCacheExtent.pixels(100.0), tree: const <TreeViewNode<String>>[]);
  TreeView<String>(tree: const <TreeViewNode<String>>[]);
  TreeViewport(
    scrollCacheExtent: ScrollCacheExtent.pixels(100.0), verticalOffset: verticalOffset,
    verticalAxisDirection: AxisDirection.down,
    horizontalOffset: horizontalOffset,
    horizontalAxisDirection: AxisDirection.right,
    delegate: treeDelegate,
    activeAnimations: const <UniqueKey, TreeViewNodesAnimation>{},
    rowDepths: const <int, int>{},
    indentation: 0.0,
  );
  RenderTreeViewport(
    scrollCacheExtent: ScrollCacheExtent.pixels(100.0), activeAnimations: const <UniqueKey, TreeViewNodesAnimation>{},
    rowDepths: const <int, int>{},
    indentation: 0.0,
    horizontalOffset: horizontalOffset,
    horizontalAxisDirection: AxisDirection.right,
    verticalOffset: verticalOffset,
    verticalAxisDirection: AxisDirection.down,
    delegate: treeDelegate,
    childManager: childManager,
  );
}
